{
  "id": "clawbot-bookkeeping",
  "name": "Clawbot Bookkeeping",
  "description": "Least-privilege local expense recording for the personal WeChat bookkeeping workflow",
  "version": "0.1.0",
  "contracts": {
    "tools": [
      "bookkeeping_health",
      "record_expense",
      "prepare_expense",
      "resolve_expense_confirmation",
      "summarize_expenses"
    ]
  },
  "activation": {
    "onStartup": true
  },
  "mcpServers": {
    "ezbookkeeping": {
      "transport": "streamable-http",
      "url": "http://127.0.0.1:8888/mcp",
      "toolFilter": {
        "include": ["query_transactions"]
      }
    }
  },
  "toolMetadata": {
    "bookkeeping_health": {
      "profiles": ["minimal"]
    },
    "record_expense": {
      "profiles": ["minimal"]
    },
    "prepare_expense": {
      "profiles": ["minimal"]
    },
    "resolve_expense_confirmation": {
      "profiles": ["minimal"]
    },
    "summarize_expenses": {
      "profiles": ["minimal"]
    }
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "serverBaseUrl": {
        "type": "string",
        "const": "http://127.0.0.1:8888"
      },
      "tokenPath": {
        "type": "string",
        "minLength": 1
      },
      "mcpTokenPath": {
        "type": "string",
        "minLength": 1
      },
      "stateDbPath": {
        "type": "string",
        "minLength": 1
      },
      "accountName": {
        "type": "string",
        "const": "日常支出"
      },
      "ledgerDisplayName": {
        "type": "string",
        "const": "日常账本"
      },
      "requestTimeoutMs": {
        "type": "integer",
        "minimum": 1,
        "maximum": 60000,
        "default": 10000
      }
    }
  }
}
